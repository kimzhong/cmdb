{
  "name": "@cmdb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CMDB 前端（Vite + React + AntD）",
  "scripts": {
    "prebuild": "pnpm --filter @cmdb/shared build",
    "predev": "pnpm --filter @cmdb/shared build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist .vite"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@cmdb/shared": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
