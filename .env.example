# ========================================
# CMDB 平台环境变量样例
# 复制为 .env 后按需修改；不要把 .env 提交到 git
# ========================================

# ---- 公共 ----
NODE_ENV=development

# ---- Server (apps/server) ----
SERVER_PORT=3030
SERVER_GLOBAL_PREFIX=api
SERVER_CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cmdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# 字段加密密钥（AES-256-GCM，需要 32 字节的 hex 串）
CMDB_FIELD_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- Web (apps/web) ----
VITE_API_BASE_URL=http://localhost:3030/api
